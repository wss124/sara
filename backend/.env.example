# Copie para .env e ajuste se necessário.
# Conexão com o PostgreSQL do docker-compose.yml
DATABASE_URL="postgresql://sara_user:sara_password@localhost:5432/sara_db?schema=public"

# Segredo usado para assinar os tokens de login (troque por um valor longo e aleatório)
JWT_SECRET="troque-este-segredo"

# Envio de e-mails (notificações). Em desenvolvimento, o Mailpit do
# docker-compose recebe tudo em http://localhost:8025. Deixe SMTP_HOST vazio
# para não enviar nada (as mensagens só aparecem no log).
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
EMAIL_REMETENTE="SARA <nao-responda@prp.uespi.br>"

# Endereço do frontend, usado nos links dos e-mails
APP_URL="http://localhost:5173"

# Minutos após o fim da reserva até a devolução ser considerada atrasada
TOLERANCIA_ATRASO_MIN="15"

# Domínios de e-mail aceitos no cadastro (só professores), separados por vírgula
DOMINIOS_PERMITIDOS="prp.uespi.br"
