generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  PROFESSOR
  ADMIN
}

enum TipoRecurso {
  SALA
  EQUIPAMENTO
}

// Situação física do recurso. "ativo" continua indicando se o cadastro está
// arquivado; o estado diz se ele pode ser usado agora.
enum EstadoRecurso {
  DISPONIVEL
  EM_USO
  EM_MANUTENCAO
  INDISPONIVEL
}

// Ciclo da reserva: PENDENTE -> APROVADA -> EM_ANDAMENTO (retirada)
// -> CONCLUIDA (devolução). RECUSADA e CANCELADA encerram o pedido sem uso.
enum StatusSolicitacao {
  PENDENTE
  APROVADA
  RECUSADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senha     String
  perfil    Perfil   @default(PROFESSOR)
  criadoEm  DateTime @default(now())

  solicitacoes      Solicitacao[] @relation("SolicitacoesDoUsuario")
  solicitacoesAprovadas Solicitacao[] @relation("AprovacoesDoAdmin")
  reservasLancadas      Solicitacao[] @relation("LancamentosDoAdmin")
  retiradasRegistradas  Solicitacao[] @relation("RetiradasRegistradas")
  devolucoesRegistradas Solicitacao[] @relation("DevolucoesRegistradas")
}

model Recurso {
  id         String      @id @default(cuid())
  nome       String
  tipo       TipoRecurso
  descricao  String?
  // Onde o recurso fica ou deve ser retirado (ex.: "Dispensa do Bloco B")
  localizacao String?
  foto       String?
  ativo      Boolean     @default(true)
  estado     EstadoRecurso @default(DISPONIVEL)
  criadoEm   DateTime    @default(now())

  solicitacoes Solicitacao[]
}

model Solicitacao {
  id            String            @id @default(cuid())
  usuario       Usuario           @relation("SolicitacoesDoUsuario", fields: [usuarioId], references: [id])
  usuarioId     String
  recurso       Recurso           @relation(fields: [recursoId], references: [id])
  recursoId     String
  dataInicio    DateTime
  dataFim       DateTime
  status        StatusSolicitacao @default(PENDENTE)
  observacao    String?

  // Reserva registrada diretamente pelo admin (pedido por telefone, balcão
  // ou uso da própria instituição). No uso institucional, usuario é o admin
  // e a observação descreve a finalidade.
  institucional Boolean           @default(false)
  lancadoPor    Usuario?          @relation("LancamentosDoAdmin", fields: [lancadoPorId], references: [id])
  lancadoPorId  String?

  aprovadoPor   Usuario?          @relation("AprovacoesDoAdmin", fields: [aprovadoPorId], references: [id])
  aprovadoPorId String?

  // Entrega e devolução registradas pelo admin no balcão
  retiradoEm               DateTime?
  retiradaRegistradaPor    Usuario?  @relation("RetiradasRegistradas", fields: [retiradaRegistradaPorId], references: [id])
  retiradaRegistradaPorId  String?
  devolvidoEm              DateTime?
  devolucaoRegistradaPor   Usuario?  @relation("DevolucoesRegistradas", fields: [devolucaoRegistradaPorId], references: [id])
  devolucaoRegistradaPorId String?
  canceladoEm              DateTime?

  criadoEm      DateTime          @default(now())
  atualizadoEm  DateTime          @updatedAt
}